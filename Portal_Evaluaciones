                                        const newPlus = current.plus === optIndex ? undefined : current.plus;
                                        setManualAnswers({
                                          ...manualAnswers,
                                          [q.id]: { ...current, minus: optIndex, plus: newPlus }
                                        });
                                      }}
                                      className={`px-2.5 py-1 rounded text-[10px] font-bold uppercase transition-all ${
                                        ans.minus === optIndex 
                                          ? 'bg-rose-500 text-white' 
                                          : 'bg-white text-slate-400 hover:bg-slate-200 border border-slate-200'
                                      }`}
                                    >
                                      - MENOS
                                    </button>
                                  </div>
                                </div>
                              ))}
                            </div>
                          </div>
                        );
                      })}
                    </div>

                    <div className="pt-4 flex justify-between gap-4 border-t border-slate-100">
                      <button
                        onClick={() => {
                          setManualAnswers({});
                          showToast("Campos del corrector manual reiniciados.");
                        }}
                        className="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-sm font-semibold transition-all"
                      >
                        Limpiar Campos
                      </button>
                      <button
                        onClick={() => {
                          const missing = [];
                          for (let i = 1; i <= 28; i++) {
                            const ans = manualAnswers[i];
                            if (!ans || ans.plus === undefined || ans.minus === undefined) {
                              missing.push(i);
                            }
                          }
                          if (missing.length > 0) {
                            showToast(`Completa los datos en las preguntas: ${missing.slice(0, 5).join(', ')}`, "error");
                            return;
                          }

                          const calculatedScores = calculateDISCScores(manualAnswers);
                          setSelectedReport({
                            id: 'manual-preview',
                            candidateName: manualCandidateName,
                            position: manualCandidatePosition,
                            createdAt: Date.now(),
                            scores: calculatedScores,
                            status: 'completed',
                            isManual: true,
                            testType: 'disc'
                          });
                        }}
                        className="flex items-center gap-2 px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-xl shadow-lg shadow-indigo-100 transition-all"
                      >
                        Ver Informe Calculado
                        <ArrowRight className="w-4 h-4" />
                      </button>
                    </div>
                  </>
                )}
              </div>
            )}

            {/* RESPUESTAS GUARDADAS */}
            {activeTab === 'reports' && !selectedReport && (
              <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 space-y-4">
                <div>
                  <h2 className="text-lg font-bold text-slate-800">Historial de Evaluaciones: {selectedTestType.toUpperCase()}</h2>
                  <p className="text-slate-400 text-sm mt-1">
                    Selecciona una de las evaluaciones completas guardadas de {selectedTestType.toUpperCase()} para visualizar su diagnóstico.
                  </p>
                </div>

                {selectedTestType !== 'disc' ? (
                  <div className="p-12 text-center text-slate-400 border border-dashed border-slate-200 rounded-xl">
                    <Layers className="w-12 h-12 text-slate-300 mx-auto mb-3" />
                    <p className="text-sm font-semibold">Base de datos de {selectedTestType.toUpperCase()} (Demo)</p>
                    <p className="text-xs mt-1">Cuando habilites este test, los candidatos respondidos se sincronizarán en este apartado.</p>
                  </div>
                ) : (
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {testList.filter(t => t.status === 'completed' && (t.testType ? t.testType === 'disc' : true)).length === 0 ? (
                      <div className="col-span-2 p-12 text-center text-slate-400 border border-dashed border-slate-200 rounded-xl">
                        <FileSpreadsheet className="w-12 h-12 text-slate-300 mx-auto mb-3" />
                        <p className="text-sm font-semibold">No hay informes finalizados aún en DISC.</p>
                        <p className="text-xs mt-1">Sincronización en la nube lista para recibir datos.</p>
                      </div>
                    ) : (
                      testList.filter(t => t.status === 'completed' && (t.testType ? t.testType === 'disc' : true)).map((report) => (
                        <div 
                          key={report.id}
                          onClick={() => setSelectedReport(report)}
                          className="p-4 border border-slate-200 hover:border-indigo-400/85 bg-white hover:bg-indigo-50/10 rounded-xl cursor-pointer shadow-sm hover:shadow-md transition-all flex items-start gap-4"
                        >
                          <div className="bg-indigo-100 p-2.5 rounded-xl text-indigo-700 flex-shrink-0">
                            <BarChart2 className="w-5 h-5" />
                          </div>
                          <div className="flex-1 min-w-0">
                            <h4 className="font-bold text-slate-800 truncate">{report.candidateName}</h4>
                            <p className="text-xs text-slate-500 font-medium truncate mb-1">{report.position}</p>
                            <div className="flex items-center justify-between mt-3 text-[10px] text-slate-400">
                              <span>Finalizado: {new Date(report.completedAt || report.createdAt).toLocaleDateString()}</span>
                              <span className="text-indigo-600 font-semibold flex items-center gap-0.5">
                                Consultar
                                <ChevronRight className="w-3.5 h-3.5" />
                              </span>
                            </div>
                          </div>
                        </div>
                      ))
                    )}
                  </div>
                )}
              </div>
            )}

            {/* INFORME CONDUCTUAL DETALLADO */}
            {selectedReport && (
              <div className="bg-white rounded-2xl shadow-sm border border-slate-200/90 overflow-hidden print:shadow-none print:border-none space-y-6">
                
                {/* Cabecera del Reporte */}
                <div className="bg-slate-900 text-white p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 border-b-4 border-indigo-600 print:bg-white print:text-slate-900 print:p-2 print:border-b-2">
                  <div className="space-y-1">
                    <span className="text-indigo-400 text-xs font-bold uppercase tracking-widest print:text-indigo-600">INFORME CONDUCTUAL CLEAVER (DISC)</span>
                    <h2 className="text-xl md:text-2xl font-bold tracking-tight text-white print:text-slate-900">{selectedReport.candidateName}</h2>
                    <div className="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-300 print:text-slate-600 font-medium">
                      <span className="flex items-center gap-1.5">
                        <Briefcase className="w-4 h-4 text-indigo-300 print:text-indigo-600" />
                        {selectedReport.position}
                      </span>
                      <span>•</span>
                      <span>Fecha: {new Date(selectedReport.completedAt || selectedReport.createdAt).toLocaleDateString()}</span>
                    </div>
                  </div>

                  <div className="flex items-center gap-2 print:hidden">
                    <button
                      onClick={handlePrint}
                      className="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition-all shadow-md shadow-indigo-900/35"
                    >
                      <Printer className="w-4 h-4" />
                      Imprimir o Guardar PDF
                    </button>
                    <button
                      onClick={() => setSelectedReport(null)}
                      className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-xl border border-slate-700"
                    >
                      Volver
                    </button>
                  </div>
                </div>

                {/* Contenido del Reporte */}
                <div className="p-6 md:p-8 space-y-8 print:p-2">
                  
                  {/* Bloque 1: Gráficas de los Perfiles */}
                  <div>
                    <h3 className="text-sm font-bold text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                      <BarChart2 className="w-4.5 h-4.5 text-indigo-600" />
                      Gráficos de Perfiles Cleaver (Percentiles de Autoimagen)
                    </h3>
                    
                    <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                      {/* Perfil I */}
                      <div className="p-4 border border-slate-100 rounded-xl bg-slate-50/50 flex flex-col items-center">
                        <div className="text-center mb-3">
                          <h4 className="text-xs font-bold text-slate-700 uppercase">Perfil I: Máscara / Diario (+)</h4>
                          <p className="text-[10px] text-slate-400">Comportamiento público</p>
                        </div>
                        {renderDISCLineGraph(selectedReport.scores.percentiles.plus)}
                      </div>

                      {/* Perfil II */}
                      <div className="p-4 border border-slate-100 rounded-xl bg-slate-50/50 flex flex-col items-center">
                        <div className="text-center mb-3">
                          <h4 className="text-xs font-bold text-slate-700 uppercase">Perfil II: Bajo Presión (-)</h4>
                          <p className="text-[10px] text-slate-400">Reacción bajo conflicto</p>
                        </div>
                        {renderDISCLineGraph(selectedReport.scores.percentiles.minus)}
                      </div>

                      {/* Perfil III */}
                      <div className="p-4 border border-slate-100 rounded-xl bg-slate-50/50 flex flex-col items-center">
                        <div className="text-center mb-3">
                          <h4 className="text-xs font-bold text-slate-700 uppercase">Perfil III: Autoimagen (Total)</h4>
                          <p className="text-[10px] text-slate-400">Estilo conductual real</p>
                        </div>
                        {renderDISCLineGraph(selectedReport.scores.percentiles.diff)}
                      </div>
                    </div>
                  </div>

                  {/* Bloque 2: Interpretación del Perfil Predominante */}
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div className="md:col-span-2 space-y-4">
                      <div className="bg-indigo-50/70 p-5 rounded-2xl border border-indigo-100">
                        <div className="flex items-center gap-2 mb-2">
                          <Sparkles className="w-5 h-5 text-indigo-600" />
                          <h4 className="font-bold text-indigo-950 text-base">
                            Patrón: {PATTERNS_COMBINATIONS.find(p => p.key === selectedReport.scores.combinationKey)?.name || PATTERNS_DB[selectedReport.scores.primaryFactor]?.name || 'Perfil Personalizado'}
                          </h4>
                        </div>
                        <p className="text-slate-700 text-sm leading-relaxed">
                          {PATTERNS_COMBINATIONS.find(p => p.key === selectedReport.scores.combinationKey)?.desc || PATTERNS_DB[selectedReport.scores.primaryFactor]?.desc || 'Este perfil muestra características únicas con combinaciones personalizadas de factores DISC.'}
                        </p>
                      </div>

                      {/* Fortalezas y Áreas de Desarrollo */}
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div className="border border-slate-100 p-4 rounded-xl space-y-2">
                          <span className="text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-100">FORTALEZAS CLAVE</span>
                          <ul className="text-xs text-slate-600 space-y-1.5 list-disc pl-4 pt-1">
                            {(PATTERNS_DB[selectedReport.scores.primaryFactor]?.strengths || []).map((st, i) => (
                              <li key={i}>{st}</li>
                            ))}
                          </ul>
                        </div>
                        <div className="border border-slate-100 p-4 rounded-xl space-y-2">
                          <span className="text-xs font-bold text-rose-700 bg-rose-50 px-2.5 py-1 rounded-full border border-rose-100">ÁREAS DE MEJORA</span>
                          <ul className="text-xs text-slate-600 space-y-1.5 list-disc pl-4 pt-1">
                            {(PATTERNS_DB[selectedReport.scores.primaryFactor]?.weaknesses || []).map((wk, i) => (
                              <li key={i}>{wk}</li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>

                    {/* Ambiente Óptimo de Trabajo */}
                    <div className="p-5 bg-slate-50 rounded-2xl border border-slate-100 flex flex-col justify-between">
                      <div className="space-y-3">
                        <h4 className="font-bold text-slate-800 text-xs uppercase tracking-widest flex items-center gap-1.5 text-slate-400">
                          <Briefcase className="w-4 h-4 text-indigo-600" />
                          Ambiente de Trabajo Ideal
                        </h4>
                        <p className="text-xs text-slate-600 leading-relaxed">
                          {PATTERNS_DB[selectedReport.scores.primaryFactor]?.environment || "Requiere un ambiente adaptado al perfil del colaborador."}
                        </p>
                      </div>

                      <div className="border-t border-slate-200/80 pt-4 mt-4 text-[11px] text-slate-500">
                        <p className="font-semibold text-slate-700 mb-1">Puntaje Bruto de Referencia:</p>
                        <div className="grid grid-cols-4 text-center">
                          <div className="bg-white py-1 border border-slate-200 rounded-l">D: {selectedReport.scores.diff.D}</div>
                          <div className="bg-white py-1 border-y border-r border-slate-200">I: {selectedReport.scores.diff.I}</div>
                          <div className="bg-white py-1 border-y border-r border-slate-200">S: {selectedReport.scores.diff.S}</div>
                          <div className="bg-white py-1 border-y border-r border-slate-200 rounded-r">C: {selectedReport.scores.diff.C}</div>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Nota confidencial */}
                  <div className="p-4 bg-slate-50 text-[11px] text-slate-400 rounded-xl leading-relaxed">
                    <strong>Nota Confidencial de Jaccard Asesorías:</strong> Los resultados reflejados en este informe conductual son una estimación científica basada en el modelo Cleaver de 28 tétradas. Deben utilizarse únicamente como un elemento de apoyo complementario en procesos de selección, desarrollo de equipos y coaching, y nunca como factor absoluto de exclusión o contratación de personal.
                  </div>

                </div>
              </div>
            )}
          </section>
        </main>
      )}

      {/* VISTA CANDIDATO (CUANDO EL CANDIDATO ABRE SU ENLACE ÚNICO) */}
      {currentView === 'candidate' && (
        <main className="flex-1 max-w-4xl w-full mx-auto p-4 md:p-8 flex flex-col items-center justify-center">
          {errorMessage ? (
            <div className="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 text-center space-y-4 max-w-md">
              <ShieldAlert className="w-12 h-12 text-rose-500 mx-auto" />
              <h3 className="text-lg font-bold text-slate-800">Evaluación no disponible</h3>
              <p className="text-sm text-slate-500 leading-relaxed">{errorMessage}</p>
            </div>
          ) : testCompleted ? (
            <div className="bg-white p-8 md:p-12 rounded-3xl shadow-lg border border-slate-200/80 text-center space-y-6 max-w-lg">
              <div className="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-inner shadow-emerald-50">
                <CheckCircle className="w-9 h-9" />
              </div>
              <div className="space-y-2">
                <h3 className="text-2xl font-bold text-slate-800">¡Test Finalizado con éxito!</h3>
                <p className="text-sm text-slate-500 leading-relaxed">
                  Muchas gracias, <strong>{candidateTestData?.candidateName || 'Candidato'}</strong>. Tus respuestas han sido registradas de forma confidencial y segura para el equipo de <strong>Jaccard Asesorías</strong>.
                </p>
              </div>
              <p className="text-xs text-slate-400">Ya puedes cerrar esta pestaña de forma segura.</p>
            </div>
          ) : (
            <div className="w-full space-y-6">
              
              {/* Encabezado del test */}
              <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/60 space-y-3">
                <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                  <div>
                    <span className="text-xs font-bold text-indigo-600 uppercase tracking-widest">TEST DE COMPORTAMIENTO CLEAVER</span>
                    <h2 className="text-xl font-bold text-slate-800">Bienvenido(a), {candidateTestData?.candidateName}</h2>
                  </div>
                  <div className="px-3 py-1 bg-slate-100 text-slate-600 text-xs font-semibold rounded-full border border-slate-200">
                    Cargo de Postulación: {candidateTestData?.position}
                  </div>
                </div>

                {/* Instrucciones */}
                <div className="text-xs md:text-sm text-slate-500 space-y-2 leading-relaxed bg-indigo-50/50 p-4 rounded-xl border border-indigo-100/60">
                  <p className="font-semibold text-indigo-950 flex items-center gap-1.5">
                    <Info className="w-4 h-4 text-indigo-600" />
                    Instrucciones importantes:
                  </p>
                  <p>
                    A continuación, encontrarás 28 grupos de 4 conceptos cada uno. Analízalos y marca:
                  </p>
                  <ul className="list-disc pl-4 space-y-1">
                    <li>La opción que <strong>MÁS (+)</strong> describa tu forma de ser en el trabajo.</li>
                    <li>La opción que <strong>MENOS (-)</strong> describa tu actitud o personalidad en el trabajo.</li>
                  </ul>
                  <p className="font-medium text-slate-600">No hay respuestas buenas ni malas. Sé espontáneo(a) y honesto(a).</p>
                </div>
              </div>

              {/* Listado de Preguntas */}
              <div className="space-y-4">
                {DISC_QUESTIONS.map((q) => {
                  const ans = candidateAnswers[q.id] || {};
                  const isCompleted = ans.plus !== undefined && ans.minus !== undefined;
                  
                  return (
                    <div 
                      key={q.id} 
                      className={`p-5 rounded-2xl shadow-sm border transition-all ${
                        isCompleted 
                          ? 'bg-white border-indigo-100' 
                          : 'bg-white border-slate-200/80 hover:border-slate-300'
                      }`}
                    >
                      <div className="flex justify-between items-center mb-4">
                        <span className="text-sm font-bold text-slate-800 flex items-center gap-2">
                          <span className={`w-6 h-6 rounded-full flex items-center justify-center text-xs ${
                            isCompleted ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-500'
                          }`}>
                            {q.id}
                          </span>
                          Bloque {q.id} de 28
                        </span>
                        {isCompleted && (
                          <span className="text-[10px] font-bold text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full border border-indigo-100 uppercase tracking-wider">Listo</span>
                        )}
                      </div>

                      <div className="grid grid-cols-1 md:grid-cols-4 gap-3">
                        {q.options.map((opt, optIdx) => {
                          const isSelectedPlus = ans.plus === optIdx;
                          const isSelectedMinus = ans.minus === optIdx;

                          return (
                            <div 
                              key={optIdx}
                              className={`p-3 rounded-xl border flex flex-row md:flex-col justify-between items-center gap-2 transition-all ${
                                isSelectedPlus 
                                  ? 'bg-emerald-50/50 border-emerald-300/80 shadow-sm' 
                                  : isSelectedMinus 
                                    ? 'bg-rose-50/50 border-rose-300/80 shadow-sm' 
                                    : 'bg-slate-50/50 border-slate-100 hover:bg-slate-50'
                              }`}
                            >
                              <span className="text-sm font-semibold text-slate-700 md:text-center">{opt.text}</span>
                              
                              <div className="flex gap-2.5">
                                <button
                                  type="button"
                                  onClick={() => {
                                    const nextMinus = isSelectedMinus ? undefined : ans.minus;
                                    setCandidateAnswers({
                                      ...candidateAnswers,
                                      [q.id]: { plus: optIdx, minus: nextMinus }
                                    });
                                  }}
                                  className={`text-xs font-bold px-3 py-1.5 rounded-lg transition-all border ${
                                    isSelectedPlus 
                                      ? 'bg-emerald-600 text-white border-emerald-600 shadow-md shadow-emerald-200' 
                                      : 'bg-white hover:bg-slate-100 text-slate-500 border-slate-200'
                                  }`}
                                >
                                  + MÁS
                                </button>

                                <button
                                  type="button"
                                  onClick={() => {
                                    const nextPlus = isSelectedPlus ? undefined : ans.plus;
                                    setCandidateAnswers({
                                      ...candidateAnswers,
                                      [q.id]: { plus: nextPlus, minus: optIdx }
                                    });
                                  }}
                                  className={`text-xs font-bold px-3 py-1.5 rounded-lg transition-all border ${
                                    isSelectedMinus 
                                      ? 'bg-rose-600 text-white border-rose-600 shadow-md shadow-rose-200' 
                                      : 'bg-white hover:bg-slate-100 text-slate-500 border-slate-200'
                                  }`}
                                >
                                  - MENOS
                                </button>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  );
                })}
              </div>

              {/* Botón de Enviar */}
              <div className="bg-white p-6 rounded-2xl shadow-md border border-slate-200/80 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div className="text-xs text-slate-400">
                  Asegúrate de que los 28 bloques de conceptos muestren la etiqueta verde de "Listo".
                </div>
                <button
                  onClick={submitCandidateAnswers}
                  className="w-full sm:w-auto px-8 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-150 transition-all flex items-center justify-center gap-2"
                >
                  <CheckCircle className="w-5 h-5" />
                  Finalizar & Enviar Test
                </button>
              </div>
            </div>
          )}
        </main>
      )}

      {/* NOTIFICACIONES TOAST FLOTANTES */}
      {toast && (
        <div className={`fixed bottom-6 right-6 z-50 flex items-center gap-2.5 px-4.5 py-3.5 rounded-xl shadow-2xl border text-sm font-semibold transition-all animate-bounce ${
          toast.type === 'error' 
            ? 'bg-rose-50 border-rose-200 text-rose-800' 
            : 'bg-emerald-50 border-emerald-200 text-emerald-800'
        }`}>
          <span>{toast.message}</span>
          <button onClick={() => setToast(null)} className="hover:opacity-70">
            <X className="w-4 h-4" />
          </button>
        </div>
      )}

      {/* MODAL PERSONALIZADO DE CONFIRMACIÓN DE BORRADO (REEMPLAZA EL CONFIRM NATIVO) */}
      {deleteConfirmation.isOpen && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 z-50 animate-fadeIn">
          <div className="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl border border-slate-100 space-y-4">
            <div className="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center">
              <ShieldAlert className="w-6 h-6" />
            </div>
            <div className="space-y-1">
              <h3 className="font-bold text-slate-800 text-base">¿Eliminar esta evaluación?</h3>
              <p className="text-xs text-slate-500 leading-relaxed">
                Esta acción no se puede deshacer y borrará permanentemente el registro del candidato y sus respuestas de la base de datos de Jaccard Asesorías.
              </p>
            </div>
            <div className="flex gap-2 pt-2">
              <button
                onClick={() => setDeleteConfirmation({ isOpen: false, id: null })}
                className="flex-1 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-all"
              >
                Cancelar
              </button>
              <button
                onClick={deleteTestRecord}
                className="flex-1 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-xl transition-all shadow-md shadow-rose-200"
              >
                Confirmar Borrado
              </button>
            </div>
          </div>
        </div>
      )}

      {/* FOOTER */}
      <footer className="bg-slate-900 border-t border-slate-800 text-slate-400 text-xs py-6 px-4 text-center mt-auto print:hidden">
        <p>© {new Date().getFullYear()} Jaccard Asesorías. Todos los derechos reservados.</p>
        <p className="text-slate-600 mt-1">Plataforma de Diagnóstico Psicométrico Cleaver Web.</p>
      </footer>
    </div>
  );
}

// --- FUNCIÓN DE DIBUJADO DE LAS GRÁFICAS CLEAVER CON SVG ---
function renderDISCLineGraph(scores) {
  const dVal = scores.D || 10;
  const iVal = scores.I || 10;
  const sVal = scores.S || 10;
  const cVal = scores.C || 10;

  const xCoords = { D: 35, I: 90, S: 145, C: 200 };

  const getY = (val) => {
    const minVal = 0;
    const maxVal = 100;
    const minPixel = 180;
    const maxPixel = 20;
    return minPixel - ((val - minVal) / (maxVal - minVal)) * (minPixel - maxPixel);
  };

  const dY = getY(dVal);
  const iY = getY(iVal);
  const sY = getY(sVal);
  const cY = getY(cVal);

  return (
    <svg width="240" height="220" className="bg-white rounded-lg border border-slate-100">
      <line x1="20" y1="180" x2="220" y2="180" stroke="#f1f5f9" strokeWidth="1.5" />
      <line x1="20" y1="140" x2="220" y2="140" stroke="#e2e8f0" strokeWidth="1" strokeDasharray="3 3" />
      <line x1="20" y1="100" x2="220" y2="100" stroke="#cbd5e1" strokeWidth="1.5" /> 
      <line x1="20" y1="60" x2="220" y2="60" stroke="#e2e8f0" strokeWidth="1" strokeDasharray="3 3" />
      <line x1="20" y1="20" x2="220" y2="20" stroke="#f1f5f9" strokeWidth="1.5" />

      <text x="10" y="104" fill="#94a3b8" fontSize="8" textAnchor="end">50%</text>
      <text x="10" y="24" fill="#94a3b8" fontSize="8" textAnchor="end">100%</text>
      <text x="10" y="184" fill="#94a3b8" fontSize="8" textAnchor="end">0%</text>

      <line x1={xCoords.D} y1="20" x2={xCoords.D} y2="180" stroke="#f1f5f9" strokeWidth="1" />
      <line x1={xCoords.I} y1="20" x2={xCoords.I} y2="180" stroke="#f1f5f9" strokeWidth="1" />
      <line x1={xCoords.S} y1="20" x2={xCoords.S} y2="180" stroke="#f1f5f9" strokeWidth="1" />
      <line x1={xCoords.C} y1="20" x2={xCoords.C} y2="180" stroke="#f1f5f9" strokeWidth="1" />

      <path 
        d={`M ${xCoords.D} ${dY} L ${xCoords.I} ${iY} L ${xCoords.S} ${sY} L ${xCoords.C} ${cY}`} 
        fill="none" 
        stroke="#4f46e5" 
        strokeWidth="2.5" 
        strokeLinecap="round"
        strokeLinejoin="round"
      />

      <circle cx={xCoords.D} cy={dY} r="5" fill="#4f46e5" />
      <rect x={xCoords.D - 12} y={dY - 18} width="24" height="12" rx="3" fill="#312e81" />
      <text x={xCoords.D} y={dY - 9} fill="#ffffff" fontSize="8" fontWeight="bold" textAnchor="middle">{dVal}%</text>

      <circle cx={xCoords.I} cy={iY} r="5" fill="#4f46e5" />
      <rect x={xCoords.I - 12} y={iY - 18} width="24" height="12" rx="3" fill="#312e81" />
      <text x={xCoords.I} y={iY - 9} fill="#ffffff" fontSize="8" fontWeight="bold" textAnchor="middle">{iVal}%</text>

      <circle cx={xCoords.S} cy={sY} r="5" fill="#4f46e5" />
      <rect x={xCoords.S - 12} y={sY - 18} width="24" height="12" rx="3" fill="#312e81" />
      <text x={xCoords.S} y={sY - 9} fill="#ffffff" fontSize="8" fontWeight="bold" textAnchor="middle">{sVal}%</text>

      <circle cx={xCoords.C} cy={cY} r="5" fill="#4f46e5" />
      <rect x={xCoords.C - 12} y={cY - 18} width="24" height="12" rx="3" fill="#312e81" />
      <text x={xCoords.C} y={cY - 9} fill="#ffffff" fontSize="8" fontWeight="bold" textAnchor="middle">{cVal}%</text>

      <text x={xCoords.D} y="202" fill="#1e293b" fontSize="11" fontWeight="bold" textAnchor="middle">D</text>
      <text x={xCoords.I} y="202" fill="#1e293b" fontSize="11" fontWeight="bold" textAnchor="middle">I</text>
      <text x={xCoords.S} y="202" fill="#1e293b" fontSize="11" fontWeight="bold" textAnchor="middle">S</text>
      <text x={xCoords.C} y="202" fill="#1e293b" fontSize="11" fontWeight="bold" textAnchor="middle">C</text>
    </svg>
  );
}
