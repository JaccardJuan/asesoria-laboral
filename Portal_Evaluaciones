export default function App() {
  // --- ESTADOS DE LA APLICACIÓN ---
  const [user, setUser] = useState(null);
  const [authLoading, setAuthLoading] = useState(true);
  const [currentView, setCurrentView] = useState('advisor'); // 'advisor' o 'candidate'
  const [activeTab, setActiveTab] = useState('dashboard'); // 'dashboard', 'manual', 'reports', 'multitest-guide'
  
  // Selector de Test Activo (Permite expandir a Kostick, Moss, etc.)
  const [selectedTestType, setSelectedTestType] = useState('disc'); 

  // Estados de candidatos y tests en tiempo real
  const [testList, setTestList] = useState([]);
  const [loadingTests, setLoadingTests] = useState(false);
  
  // Estado para creación de nuevos tests
  const [newCandidateName, setNewCandidateName] = useState('');
  const [newCandidatePosition, setNewCandidatePosition] = useState('');
  
  // Estado para visualización de informes
  const [selectedReport, setSelectedReport] = useState(null);
  const [searchTerm, setSearchTerm] = useState('');

  // Estado para responder el test (Vista Candidato)
  const [candidateTestId, setCandidateTestId] = useState(null);
  const [candidateTestData, setCandidateTestData] = useState(null);
  const [candidateAnswers, setCandidateAnswers] = useState({}); 
  const [testCompleted, setTestCompleted] = useState(false);
  const [errorMessage, setErrorMessage] = useState('');

  // Estado para Corrector Manual Rápido 
  const [manualAnswers, setManualAnswers] = useState({});
  const [manualCandidateName, setManualCandidateName] = useState('Candidato Manual');
  const [manualCandidatePosition, setManualCandidatePosition] = useState('Puesto Genérico');

  // Modal personalizado para confirmaciones seguras (evita usar window.confirm)
  const [deleteConfirmation, setDeleteConfirmation] = useState({ isOpen: false, id: null });

  // Notificaciones flotantes
  const [toast, setToast] = useState(null);

  const showToast = (message, type = 'success') => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 4000);
  };

  useEffect(() => {
    const initAuth = async () => {
      if (!auth) {
        setAuthLoading(false);
        return;
      }
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Fallo de autenticación Firebase:", err);
      } finally {
        setAuthLoading(false);
      }
    };
    initAuth();

    if (auth) {
      const unsubscribe = onAuthStateChanged(auth, (usr) => {
        setUser(usr);
      });
      return () => unsubscribe();
    }
  }, []);

  // Revisar si la URL tiene un testId para cargarlo inmediatamente como Candidato
  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const testId = params.get('testId');
    if (testId) {
      setCandidateTestId(testId);
      setCurrentView('candidate');
      fetchCandidateTest(testId);
    }
  }, [user]);

  // Suscripción a la colección de Tests en tiempo real
  useEffect(() => {
    if (!user || !db) return;
    setLoadingTests(true);
    const qCol = collection(db, 'artifacts', appId, 'public', 'data', 'tests');
    
    const unsubscribe = onSnapshot(qCol, (snapshot) => {
      const list = [];
      snapshot.forEach((docSnap) => {
        list.push({ id: docSnap.id, ...docSnap.data() });
      });
      list.sort((a, b) => b.createdAt - a.createdAt);
      setTestList(list);
      setLoadingTests(false);
    }, (error) => {
      console.error("Error cargando tests:", error);
      setLoadingTests(false);
    });

    return () => unsubscribe();
  }, [user]);

  const fetchCandidateTest = async (tId) => {
    if (!db) return;
    try {
      const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'tests', tId);
      const docSnap = await getDoc(docRef);
      if (docSnap.exists()) {
        const data = docSnap.data();
        if (data.status === 'completed') {
          setTestCompleted(true);
        }
        setCandidateTestData(data);
        if (data.testType) {
          setSelectedTestType(data.testType);
        }
      } else {
        setErrorMessage("La evaluación solicitada no existe o el enlace ha caducado.");
      }
    } catch (e) {
      setErrorMessage("Error de conexión al cargar la evaluación.");
    }
  };

  const createNewTestLink = async (e) => {
    e.preventDefault();
    if (!newCandidateName.trim()) {
      showToast("Ingresa el nombre del candidato", "error");
      return;
    }
    if (!db) {
      showToast("La base de datos no está activa.", "error");
      return;
    }

    try {
      const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'tests');
      const docData = {
        candidateName: newCandidateName.trim(),
        position: newCandidatePosition.trim() || 'No especificado',
        testType: selectedTestType, // Guarda qué tipo de test es (disc, kostick, moss, etc.)
        status: 'pending',
        createdAt: Date.now(),
        answers: null,
        scores: null
      };
      
      await addDoc(colRef, docData);
      setNewCandidateName('');
      setNewCandidatePosition('');
      showToast(`Evaluación creada con éxito para ${docData.candidateName}`);
    } catch (err) {
      console.error(err);
      showToast("Error al crear la evaluación", "error");
    }
  };

  const deleteTestRecord = async () => {
    const id = deleteConfirmation.id;
    if (!db || !id) return;
    try {
      await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'tests', id));
      showToast("Registro eliminado con éxito");
      if (selectedReport && selectedReport.id === id) {
        setSelectedReport(null);
      }
      setDeleteConfirmation({ isOpen: false, id: null });
    } catch (err) {
      showToast("Error al eliminar", "error");
    }
  };

  const submitCandidateAnswers = async () => {
    if (selectedTestType !== 'disc') {
      showToast("Prueba de demostración enviada.", "success");
      setTestCompleted(true);
      return;
    }

    const missing = [];
    for (let i = 1; i <= 28; i++) {
      const ans = candidateAnswers[i];
      if (!ans || ans.plus === undefined || ans.minus === undefined) {
        missing.push(i);
      }
    }

    if (missing.length > 0) {
      showToast(`Responde MÁS (+) y MENOS (-) en las preguntas: ${missing.slice(0, 5).join(', ')}${missing.length > 5 ? '...' : ''}`, "error");
      return;
    }

    const scores = calculateDISCScores(candidateAnswers);

    if (db && candidateTestId) {
      try {
        const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'tests', candidateTestId);
        await updateDoc(docRef, {
          status: 'completed',
          answers: candidateAnswers,
          scores: scores,
          completedAt: Date.now()
        });
        setTestCompleted(true);
        showToast("¡Respuestas enviadas correctamente! Muchas gracias.");
      } catch (err) {
        showToast("Error al guardar respuestas en el servidor.", "error");
      }
    } else {
      showToast("Guardado de simulación completado.");
    }
  };

  const calculateDISCScores = (answersMap) => {
    const plusCounts = { D: 0, I: 0, S: 0, C: 0 };
    const minusCounts = { D: 0, I: 0, S: 0, C: 0 };

    DISC_QUESTIONS.forEach((q) => {
      const qAns = answersMap[q.id];
      if (qAns) {
        if (qAns.plus !== undefined) {
          const factorPlus = q.options[qAns.plus].plus;
          if (plusCounts[factorPlus] !== undefined) plusCounts[factorPlus]++;
        }
        if (qAns.minus !== undefined) {
          const factorMinus = q.options[qAns.minus].minus;
          if (minusCounts[factorMinus] !== undefined) minusCounts[factorMinus]++;
        }
      }
    });

    const diffScores = {
      D: plusCounts.D - minusCounts.D,
      I: plusCounts.I - minusCounts.I,
      S: plusCounts.S - minusCounts.S,
      C: plusCounts.C - minusCounts.C
    };

    const toPercentile = (val, factor, type) => {
      let raw = val;
      if (type === 'plus') {
        if (factor === 'D') return Math.min(100, Math.max(5, raw * 7 + 10));
        if (factor === 'I') return Math.min(100, Math.max(5, raw * 7 + 15));
        if (factor === 'S') return Math.min(100, Math.max(5, raw * 6 + 12));
        if (factor === 'C') return Math.min(100, Math.max(5, raw * 7 + 8));
      } else if (type === 'minus') {
        if (factor === 'D') return Math.min(100, Math.max(5, raw * 7 + 8));
        if (factor === 'I') return Math.min(100, Math.max(5, raw * 8 + 10));
        if (factor === 'S') return Math.min(100, Math.max(5, raw * 7 + 12));
        if (factor === 'C') return Math.min(100, Math.max(5, raw * 6 + 15));
      } else { 
        const shifted = raw + 15; 
        return Math.min(100, Math.max(1, Math.round((shifted / 30) * 100)));
      }
      return 50;
    };

    const percentiles = {
      plus: {
        D: toPercentile(plusCounts.D, 'D', 'plus'),
        I: toPercentile(plusCounts.I, 'I', 'plus'),
        S: toPercentile(plusCounts.S, 'S', 'plus'),
        C: toPercentile(plusCounts.C, 'C', 'plus'),
      },
      minus: {
        D: toPercentile(minusCounts.D, 'D', 'minus'),
        I: toPercentile(minusCounts.I, 'I', 'minus'),
        S: toPercentile(minusCounts.S, 'S', 'minus'),
        C: toPercentile(minusCounts.C, 'C', 'minus'),
      },
      diff: {
        D: toPercentile(diffScores.D, 'D', 'diff'),
        I: toPercentile(diffScores.I, 'I', 'diff'),
        S: toPercentile(diffScores.S, 'S', 'diff'),
        C: toPercentile(diffScores.C, 'C', 'diff'),
      }
    };

    const sortedFactors = Object.entries(percentiles.diff).sort((a, b) => b[1] - a[1]);
    const primaryFactor = sortedFactors[0][0];
    const secondaryFactor = sortedFactors[1][1] > 60 ? sortedFactors[1][0] : '';
    const combinationKey = secondaryFactor ? `${primaryFactor}${secondaryFactor}` : primaryFactor;

    return {
      plus: plusCounts,
      minus: minusCounts,
      diff: diffScores,
      percentiles,
      primaryFactor,
      combinationKey
    };
  };

